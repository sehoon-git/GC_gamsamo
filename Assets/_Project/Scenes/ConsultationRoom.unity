--- !u!114 &459871655
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 459871646}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 18da9a1cde5ba9145b123dddd7460df2, type: 3}
  m_Name:
  m_EditorClassIdentifier: Assembly-CSharp::Gamsamo.Dialogue.PatientVisitController
  room: {fileID: 459871648}
  doorButton: {fileID: 1182503261}
  portraitImage: {fileID: 1615010615}
  portraitGroup: {fileID: 1615010614}
  portraitRoot: {fileID: 1615010612}
  dialogue: {fileID: 374133832}
  patients:
  - patientId: seoyun
    displayName: "\uC11C\uC724"
    portrait: {fileID: 21300000, guid: fc07c10f9a6349047aece67dacaeec24, type: 3}
    demoLines:
    - "\uC548\uB155\uD558\uC138\uC694, \uC11C\uC724\uC774\uC5D0\uC694. \uB9C9\uC0C1
      \uC549\uC73C\uB2C8 \uC870\uAE08 \uAE34\uC7A5\uB418\uB124\uC694."
    - "\uC5B4\uB514\uC11C\uBD80\uD130 \uC774\uC57C\uAE30\uD558\uBA74 \uC88B\uC744\uAE4C\uC694?
      \uCC9C\uCC9C\uD788 \uB9D0\uC500\uB4DC\uB824\uB3C4 \uAD1C\uCC2E\uC8E0?"
    - "\uC624\uB298\uC740 \uC81C \uC774\uC57C\uAE30\uB97C \uC870\uAE08 \uAEBC\uB0B4
      \uBCF4\uACE0 \uC2F6\uC5B4\uC694."
  - patientId: dohyeon
    displayName: "\uB3C4\uD604"
    portrait: {fileID: 21300000, guid: c77649eceadfa524985ea359a26097bc, type: 3}
    demoLines:
    - "\uC548\uB155\uD558\uC138\uC694. \uB3C4\uD604\uC774\uB77C\uACE0 \uD569\uB2C8\uB2E4.
      \uC774\uB807\uAC8C \uC774\uC57C\uAE30\uD558\uB294 \uC790\uB9AC\uB294 \uCC98\uC74C\uC774\uB124\uC694."
    - "\uAD1C\uCC2E\uB2E4\uACE0 \uB118\uACA8 \uC628 \uC77C\uB4E4\uC744 \uD55C\uBC88
      \uB3CC\uC544\uBCF4\uACE0 \uC2F6\uC5C8\uC2B5\uB2C8\uB2E4."
    - "\uC11C\uB450\uB974\uC9C0 \uC54A\uACE0 \uD558\uB098\uC529 \uC774\uC57C\uAE30\uD574
      \uBCFC\uAC8C\uC694."
  - patientId: minseok
    displayName: "\uBBFC\uC11D"
    portrait: {fileID: 21300000, guid: e9227b93ca931c5488d82a1ea89842de, type: 3}
    demoLines:
    - "\uBBFC\uC11D\uC785\uB2C8\uB2E4. \uC81C \uC774\uC57C\uAE30\uB97C \uC5B4\uB5BB\uAC8C
      \uC804\uD560\uC9C0 \uC624\uB294 \uAE38\uC5D0\uB3C4 \uC0DD\uAC01\uD588\uC5B4\uC694."
    - "\uB9D0\uB85C \uC815\uB9AC\uD558\uBA74 \uC870\uAE08 \uB354 \uC798 \uBCF4\uC77C
      \uAC83 \uAC19\uC544\uC11C \uCC3E\uC544\uC654\uC2B5\uB2C8\uB2E4."
    - "\uBA3C\uC800 \uCD5C\uADFC\uC5D0 \uC788\uC5C8\uB358 \uC77C\uBD80\uD130 \uB9D0\uC500\uB4DC\uB9B4\uAC8C\uC694."
  - patientId: taejun
    displayName: "\uD0DC\uC900"
    portrait: {fileID: 21300000, guid: f120c98415a3ed740b50f7da748344bf, type: 3}
    demoLines:
    - "\uC548\uB155\uD558\uC138\uC694. \uD0DC\uC900\uC785\uB2C8\uB2E4. \uC7A0\uC2DC
      \uB9C8\uC74C\uC744 \uC815\uB9AC\uD560 \uC2DC\uAC04\uC774 \uD544\uC694\uD588\uC5B4\uC694."
    - "\uC775\uC219\uD55C \uC77C\uB3C4 \uC694\uC998\uC5D0\uB294 \uB2E4\uB974\uAC8C
      \uB290\uAEF4\uC9C8 \uB54C\uAC00 \uC788\uB354\uAD70\uC694."
    - "\uC624\uB298\uC740 \uD3B8\uD558\uAC8C \uC81C \uC0DD\uAC01\uC744 \uB098\uB220
      \uBCF4\uACE0 \uC2F6\uC2B5\uB2C8\uB2E4."
  - patientId: jieun
    displayName: "\uC9C0\uC740"
    portrait: {fileID: 21300000, guid: aea8faf42938e374fa75a7d103198a6f, type: 3}
    demoLines:
    - "\uC548\uB155\uD558\uC138\uC694, \uC9C0\uC740\uC774\uC5D0\uC694. \uC774\uACF3\uC740
      \uBD84\uC704\uAE30\uAC00 \uCC38 \uB530\uB73B\uD558\uB124\uC694."
    - "\uD3C9\uC18C\uC5D0\uB294 \uB2E4\uB978 \uC0AC\uB78C \uC774\uC57C\uAE30\uB97C
      \uB4E3\uB294 \uCABD\uC778\uB370, \uC624\uB298\uC740 \uC81C \uC598\uAE30\uB97C
      \uD574 \uBCF4\uB824\uACE0\uC694."
    - "\uC870\uAE08 \uB450\uC11C\uC5C6\uC5B4\uB3C4 \uAD1C\uCC2E\uB2E4\uBA74 \uCC9C\uCC9C\uD788
      \uC2DC\uC791\uD574 \uBCFC\uAC8C\uC694."
  - patientId: harin
    displayName: "\uD558\uB9B0"
    portrait: {fileID: 21300000, guid: 7fb982d5e4083f4489438718fafd58fb, type: 3}
    demoLines:
    - "\uC548\uB155\uD558\uC138\uC694! \uD558\uB9B0\uC774\uC5D0\uC694. \uBB38 \uC55E\uC5D0\uC11C\uB294
      \uB9DD\uC124\uC600\uB294\uB370 \uB4E4\uC5B4\uC624\uAE38 \uC798\uD55C \uAC83
      \uAC19\uC544\uC694."
    - "\uB9D0\uD558\uACE0 \uC2F6\uC5C8\uB358 \uC77C\uC774 \uBA87 \uAC00\uC9C0 \uC788\uC5C8\uC5B4\uC694.
      \uD558\uB098\uC529 \uC774\uC57C\uAE30\uD574 \uBCFC\uAE4C\uC694?"
    - "\uB4E4\uC5B4 \uC8FC\uC154\uC11C \uACE0\uB9C8\uC6CC\uC694. \uC870\uAE08\uC740
      \uD3B8\uD558\uAC8C \uB9D0\uD560 \uC218 \uC788\uC744 \uAC83 \uAC19\uC544\uC694."
  entryOffset: {x: -500, y: 0}
  entryDuration: 0.65
  exitDuration: 0.3
  useDemoDialogue: 1
