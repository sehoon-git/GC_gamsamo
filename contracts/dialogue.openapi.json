  "components": {
    "schemas": {
      "CaseState": {
        "properties": {
          "format_version": {
            "type": "integer",
            "const": 4,
            "title": "Format Version",
            "default": 4
          },
          "content_version": {
            "type": "string",
            "title": "Content Version",
            "default": "seoyun-4.0"
          },
          "case_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$",
            "title": "Case Id"
          },
          "patient_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$",
            "title": "Patient Id",
            "default": "seoyun"
          },
          "game_progress_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$",
            "title": "Game Progress Id",
            "default": "legacy"
          },
          "revision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Revision",
            "default": 0
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "revealed_fact_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Revealed Fact Ids"
          },
          "memory": {
            "$ref": "#/components/schemas/Memory"
          },
          "sessions": {
            "items": {
              "$ref": "#/components/schemas/Session"
            },
            "type": "array",
            "minItems": 1,
            "title": "Sessions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "CaseState"
      },
      "CloseRequest": {
        "properties": {
          "state": {
            "$ref": "#/components/schemas/CaseState"
          },
          "session_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$",
            "title": "Session Id"
          },
          "request_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$",
            "title": "Request Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "state",
          "session_id",
          "request_id"
        ],
        "title": "CloseRequest"
      },
      "CriterionScore": {
        "properties": {
          "criterion_id": {
            "type": "string",
            "title": "Criterion Id"
          },
          "score": {
            "type": "integer",
            "maximum": 25.0,
            "minimum": 0.0,
            "title": "Score"
          },
          "explanation": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Explanation"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "type": "array",
            "maxItems": 4,
            "title": "Evidence"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "criterion_id",
          "score",
          "explanation",
          "evidence"
        ],
        "title": "CriterionScore"
      },
      "EvaluateRequest": {
        "properties": {
          "state": {
            "$ref": "#/components/schemas/CaseState"
          },
          "session_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$",
            "title": "Session Id"
          },
          "request_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$",
            "title": "Request Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "state",
          "session_id",
          "request_id"
        ],
        "title": "EvaluateRequest"
      },
      "Evaluation": {
        "properties": {
          "scores": {
            "items": {
              "$ref": "#/components/schemas/CriterionScore"
            },
            "type": "array",
            "maxItems": 8,
            "minItems": 8,
            "title": "Scores"
          },
          "patient_score": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Patient Score"
          },
          "counselor_score": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Counselor Score"
          },
          "cleared": {
            "type": "boolean",
            "title": "Cleared"
          },
          "evaluated_at": {
            "type": "string",
            "title": "Evaluated At"
          },
          "model_revision": {
            "type": "string",
            "title": "Model Revision"
          },
          "prompt_version": {
            "type": "string",
            "title": "Prompt Version"
          },
          "source_messages": {
            "type": "integer",
            "title": "Source Messages"
          },
          "metrics": {
            "$ref": "#/components/schemas/Metrics"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "scores",
          "patient_score",
          "counselor_score",
          "cleared",
          "evaluated_at",
          "model_revision",
          "prompt_version",
          "source_messages"
        ],
        "title": "Evaluation"
      },
      "Evidence": {
        "properties": {
          "message_id": {
            "type": "string",
            "title": "Message Id"
          },
          "quote": {
            "type": "string",
            "maxLength": 400,
            "minLength": 1,
            "title": "Quote"
          },
          "counter": {
            "type": "boolean",
            "title": "Counter",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "message_id",
          "quote"
        ],
        "title": "Evidence"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Memory": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/MemoryItem"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Items"
          },
          "through_turn_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,80}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Through Turn Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Memory"
      },
      "MemoryItem": {
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "fact",
              "emotion",
              "plan",
              "unresolved",
              "deferred"
            ],
            "title": "Category"
          },
          "speaker": {
            "type": "string",
            "enum": [
              "patient",
              "counselor",
              "both"
            ],
            "title": "Speaker"
          },
          "text": {
            "type": "string",
            "maxLength": 320,
            "minLength": 1,
            "title": "Text"
          },
          "source_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 4,
            "minItems": 1,
            "title": "Source Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "category",
          "speaker",
          "text",
          "source_ids"
        ],
        "title": "MemoryItem"
      },
      "Metrics": {
        "properties": {
          "seconds": {
            "type": "number",
            "title": "Seconds",
            "default": 0
          },
          "calls": {
            "type": "integer",
            "title": "Calls",
            "default": 0
          },
          "prompt_tokens": {
            "type": "integer",
            "title": "Prompt Tokens",
            "default": 0
          },
          "completion_tokens": {
            "type": "integer",
            "title": "Completion Tokens",
            "default": 0
          },
          "role_seconds": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Role Seconds"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Metrics"
      },
      "OpenRequest": {
        "properties": {
          "state": {
            "$ref": "#/components/schemas/CaseState"
          },
          "session_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$",
            "title": "Session Id"
          },
          "request_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$",
            "title": "Request Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "state",
          "session_id",
          "request_id"
        ],
        "title": "OpenRequest"
      },
      "Opening": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$",
            "title": "Id"
          },
          "patient_text": {
            "type": "string",
            "minLength": 1,
            "title": "Patient Text"
          },
          "candidate_fact_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 3,
            "title": "Candidate Fact Ids"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "metrics": {
            "$ref": "#/components/schemas/Metrics"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "patient_text"
        ],
        "title": "Opening",
        "description": "A patient's first utterance, with no invented counselor message."
      },
      "PatientCatalogResponse": {
        "properties": {
          "catalog_version": {
            "type": "integer",
            "const": 1,
            "title": "Catalog Version",
            "default": 1
          },
          "patients": {
            "items": {
              "$ref": "#/components/schemas/PatientInfo"
            },
            "type": "array",
            "title": "Patients"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "patients"
        ],
        "title": "PatientCatalogResponse"
      },
      "PatientInfo": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "aliases": {
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,80}$"
            },
            "type": "array",
            "title": "Aliases"
          },
          "ready": {
            "type": "boolean",
            "title": "Ready"
          },
          "content_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Version"
          },
          "unavailable_reason": {
            "type": "string",
            "title": "Unavailable Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "aliases",
          "ready",
          "content_version",
          "unavailable_reason"
        ],
        "title": "PatientInfo"
      },
      "RevisitRequest": {
        "properties": {
          "state": {
            "$ref": "#/components/schemas/CaseState"
          },
          "session_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$",
            "title": "Session Id"
          },
          "request_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$",
            "title": "Request Id"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "state",
          "session_id",
          "request_id"
        ],
        "title": "RevisitRequest"
      },
      "Session": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$",
            "title": "Id"
          },
          "started_at": {
            "type": "string",
            "title": "Started At"
          },
          "closed_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Closed At"
          },
          "opening": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Opening"
              },
              {
                "type": "null"
              }
            ]
          },
          "phase": {
            "type": "string",
            "enum": [
              "active",
              "closing",
              "pending_evaluation",
              "evaluated"
            ],
            "title": "Phase",
            "default": "active"
          },
          "closing_request_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,80}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Closing Request Id"
          },
          "closing_text": {
            "type": "string",
            "title": "Closing Text",
            "default": ""
          },
          "closing_speaker": {
            "type": "string",
            "const": "counselor",
            "title": "Closing Speaker",
            "default": "counselor"
          },
          "closing_metrics": {
            "$ref": "#/components/schemas/Metrics"
          },
          "turns": {
            "items": {
              "$ref": "#/components/schemas/Turn"
            },
            "type": "array",
            "title": "Turns"
          },
          "evaluation": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Evaluation"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Session"
      },
      "StartRequest": {
        "properties": {
          "patient_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$",
            "title": "Patient Id"
          },
          "game_progress_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$",
            "title": "Game Progress Id",
            "default": "legacy"
          },
          "case_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$",
            "title": "Case Id"
          },
          "session_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$",
            "title": "Session Id"
          },
          "request_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$",
            "title": "Request Id"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "patient_id",
          "case_id",
          "session_id",
          "request_id"
        ],
        "title": "StartRequest"
      },
      "StateResponse": {
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$",
            "title": "Case Id"
          },
          "session_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$",
            "title": "Session Id"
          },
