# Export these variables in the shell before running the scripts.
SEOYUN_VLLM_URL=http://127.0.0.1:8000
SEOYUN_API_URL=http://127.0.0.1:8001
# Optional local API keys. Never commit real keys.
SEOYUN_API_KEY=
SEOYUN_VLLM_API_KEY=
# Default: $XDG_DATA_HOME/gc-gamsamo/seoyun or ~/.local/share/gc-gamsamo/seoyun
# SEOYUN_DATA_DIR=/absolute/path/outside/repository

SEOYUN_MODEL_CONFIG=ai/configs/seoyun.json
# Integration fixtures only; set 0 for real inference.
SEOYUN_MOCK=0
